config global 'global'
	option config_path '/etc/vnt2_config'
	option bin_path '/usr/bin'
	option arch 'auto'
	option mirror 'github'
	option web_token ''
	option web_addr '0.0.0.0:19099'
	option web_enabled '0'
	option web_data_dir '/vnt_config'
	option web_sync_timeout '60'
	option auto_update '0'
	option update_interval '7'
	option upx_compressed '0'
	option respawn_threshold '3600'
	option respawn_timeout '5'
	option respawn_retry '5'
	option log_to_file '1'
	option log_errors_only '0'
	option log_max_kb '300'
	option startup_check_window '60'
	option kill_interval '1800'
	option fw_vnt_to_lan '1'
	option fw_lan_to_vnt '1'
	option fw_vnt_to_wan '0'
	option fw_wan_to_vnt '0'
	option fw_vnt_web '0'
	option fw_vnts_web '0'
	option theme 'light'
	option web_sync_keys 'POST /api/config|POST /api/start|POST /api/stop|POST /api/restart'
	option web_start_keys 'Starting VNT service|启用|启动配置|enable|enabled'
	option web_stop_keys '禁用|停用|停止配置|disable|disabled'
	option web_delete_keys '删除配置|删除|delete config|deleted config|DELETE /api/config'
	option fault_restart_keys 'Registration failed'
	option online_keys 'public_addr'
	option online_exclude_keys '0.0.0.0:0'

config template 'template_vnt'
	option type 'vnt'
	option name 'default'

config template 'template_vnts'
	option type 'vnts'
	option name 'default'

config port_detect 'default'
	option enabled '1'
	option check_config '1'
	option check_system '1'
	list ignore_param 'endpoint'
	list ignore_param 'peer_servers'
	list ignore_param 'server_addr'
	list ignore_param 'server_address'
	list ignore_param 'remote_addr'
	list ignore_param 'remote'

config command 'start_vnt_web'
	option role 'client_web'
	option label 'Startup Parameters'
	option binary 'vnt_web'
	option command '{bin} --addr {web_addr} --token {token}'

config command 'start_vnt_cli'
	option role 'client_cli'
	option label 'Startup Parameters'
	option binary 'vnt_cli'
	option command '{bin} --conf {conf}'

config command 'start_vnts'
	option role 'server'
	option label 'Startup Parameters'
	option binary 'vnts'
	option command '{bin} -c {conf}'

config query 'ctrl_info'
	option role 'client_cli'
	option cmd 'info'
	option label 'Info'
	option binary 'vnt_ctrl'
	option command '{bin} -p {ctrl_port} info'

config query 'ctrl_ips'
	option role 'client_cli'
	option cmd 'ips'
	option label 'IP List'
	option binary 'vnt_ctrl'
	option command '{bin} -p {ctrl_port} ips'

config query 'ctrl_clients'
	option role 'client_cli'
	option cmd 'clients'
	option label 'Clients'
	option binary 'vnt_ctrl'
	option command '{bin} -p {ctrl_port} clients'

config query 'ctrl_route'
	option role 'client_cli'
	option cmd 'route'
	option label 'Route'
	option binary 'vnt_ctrl'
	option command '{bin} -p {ctrl_port} route'
