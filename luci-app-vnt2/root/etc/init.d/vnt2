#!/bin/sh /etc/rc.common
# /etc/init.d/vnt2

START=99
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="refresh_tuntap_firewall"
EXTRA_HELP="	refresh_tuntap_firewall  Rescan TUN/TAP devices and reload fw4 include"

BIN_PATH="/usr/bin"
CONFIG_PATH="/etc/vnt2_config"
LOG_DIR="/tmp/vnt2_log"
RUN_DIR="/var/run/vnt2"
TUNTAP_NFT="${RUN_DIR}/tuntap.nft"
TUNTAP_RELOAD_LOCK="${RUN_DIR}/fw_reload_pending"
TUNTAP_INCLUDE="vnt2_tuntap"
CRON_TAG="vnt2_auto_update"
UPDATE_SCRIPT="/usr/libexec/vnt2-update.sh"
CRON_FILE="/etc/crontabs/root"
FW_ZONE="vnt2_vnt"
VNT_RUN="/usr/libexec/vnt2-run.sh"
INITD="/etc/init.d"
IFACE_PREFIX="vnt2"
RESPAWN_THRESHOLD=3600
RESPAWN_TIMEOUT=5
RESPAWN_RETRY=5
STARTUP_CHECK_WINDOW=60
KILL_INTERVAL=1800
WEB_TOKEN=""
WEB_ADDR="0.0.0.0:19099"
WEB_ENABLED="1"
WEB_DATA_DIR="/vnt_config"
WEB_INSTANCE="vnt2_web"

VNT_PORT_FIELDS="tcp_bind quic_bind ws_bind tunnel_port tunnel_addr"
VNTS_PORT_FIELDS="tcp_bind quic_bind ws_bind server_quic_bind"

FW_FORWARD_DEFS="
fw_lan_to_vnt|lan|${FW_ZONE}
fw_vnt_to_lan|${FW_ZONE}|lan
fw_vnt_to_wan|${FW_ZONE}|wan
fw_wan_to_vnt|wan|${FW_ZONE}
"

init_paths() {
    local v
    v=$(uci -q get vnt2.global.config_path);       [ -n "$v" ] && CONFIG_PATH="$v"
    v=$(uci -q get vnt2.global.bin_path);          [ -n "$v" ] && BIN_PATH="$v"
    v=$(uci -q get vnt2.global.respawn_threshold); [ -n "$v" ] && RESPAWN_THRESHOLD="$v"
    v=$(uci -q get vnt2.global.respawn_timeout);   [ -n "$v" ] && RESPAWN_TIMEOUT="$v"
    v=$(uci -q get vnt2.global.respawn_retry);     [ -n "$v" ] && RESPAWN_RETRY="$v"
    v=$(uci -q get vnt2.global.startup_check_window); [ -n "$v" ] && STARTUP_CHECK_WINDOW="$v"
    v=$(uci -q get vnt2.global.kill_interval);     [ -n "$v" ] && KILL_INTERVAL="$v"
    WEB_TOKEN=$(uci -q get vnt2.global.web_token)
    v=$(uci -q get vnt2.global.web_addr); [ -n "$v" ] && WEB_ADDR="$v"
    v=$(uci -q get vnt2.global.web_enabled); [ -n "$v" ] && WEB_ENABLED="$v"
    v=$(uci -q get vnt2.global.web_data_dir); [ -n "$v" ] && WEB_DATA_DIR="$v"
    mkdir -p "$CONFIG_PATH" "$LOG_DIR" "$RUN_DIR" "$WEB_DATA_DIR"
}


adv_get() {
    local section="$1" option="$2" fallback="$3" v
    v=$(uci -q get "vnt2.${section}.${option}" 2>/dev/null)
    [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$fallback"
}

adv_bin() {
    local profile="$1" fallback="$2"
    printf '%s/%s' "${BIN_PATH%/}" "$fallback"
}

adv_cmd() {
    local section="$1" fallback="$2" v
    v=$(adv_get "$section" command "")
    [ -n "$v" ] && printf '%s' "$v" && return
    adv_get "$section" template "$fallback"
}

render_template() {
    local tpl="$1" bin="$2" conf="$3" name="$4" type="$5"
    printf '%s' "$tpl" \
        | sed "s|{bin}|$bin|g" \
        | sed "s|{conf}|$conf|g" \
        | sed "s|{name}|$name|g" \
        | sed "s|{type}|$type|g" \
        | sed "s|{web_addr}|$WEB_ADDR|g" \
        | sed "s|{token}|$WEB_TOKEN|g" \
        | sed "s|{file_name}|$(basename "$conf")|g"
}

cmdline_to_pipes() {
    echo "$1" | awk '{ for (i = 1; i <= NF; i++) { printf "%s%s", (i == 1 ? "" : "|"), $i } }'
}

make_tmp() {
    local f
    f=$(mktemp)
    echo "$f"
}

read_field() {
    grep -m1 "^${2}[[:space:]]*=" "$1" 2>/dev/null \
        | sed 's/^[^=]*=[[:space:]]*//' \
        | sed 's/^["'"'"']//;s/["'"'"']$//' \
        | tr -d '\r\n'
}

read_section_field() {
    awk -v sec="$2" -v key="$3" '
        $0 ~ "^[[:space:]]*\[" sec "\][[:space:]]*$" { hit=1; next }
        hit && $0 ~ "^[[:space:]]*\[" { exit }
        hit {
            line=$0
            sub(/^[[:space:]]*#?[[:space:]]*/, "", line)
            if (line ~ "^" key "[[:space:]]*=") {
                sub(/^[^=]*=[[:space:]]*/, "", line)
                sub(/[[:space:]]+#.*$/, "", line)
                gsub(/^[ \t"\047]+|[ \t"\047]+$/, "", line)
                print line
                exit
            }
        }
    ' "$1" 2>/dev/null | tr -d '\r\n'
}

get_tun_name() {
    local conf="${CONFIG_PATH}/${1}.${2}"
    [ -f "$conf" ] && read_field "$conf" "tun_name"
}

iface_sid() {
    printf '%s_%s' "$IFACE_PREFIX" "$1" | tr -cd 'a-zA-Z0-9_' | cut -c1-15
}

extract_port() {
    local v="$1" p
    p=$(printf '%s' "$v" | grep -oE ':[0-9]+' | tr -d ':' | tail -1)
    [ -z "$p" ] && p=$(printf '%s' "$v" | grep -oE '^[0-9]+$')
    [ -n "$p" ] && printf '%s\n' "$p"
}

extract_port_mappings() {
    grep -E "^port_mapping[[:space:]]*=" "$1" 2>/dev/null \
        | grep -oE '"[^"]+"' \
        | tr -d '"' \
        | while read -r rule; do
            local proto port
            proto=$(printf '%s' "$rule" | grep -oE '^[a-z]+')
            port=$(printf '%s' "$rule" \
                | sed 's|^[a-z]*://||' \
                | cut -d'-' -f1 \
                | grep -oE ':[0-9]+' | tr -d ':')
            [ -n "$proto" ] && [ -n "$port" ] \
                && printf '%s:%s\n' "$proto" "$port"
        done
}

get_lan_ip() {
    uci -q get network.lan.ipaddr
}

_instance_log() {
    local msg="$2"
    printf '[%s] >>> %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" \
        >> "${LOG_DIR}/${1}.log"
    echo "[${1}] $msg"
}

is_instance_running() {
    local pid
    pid=$(cat "/var/run/vnt2_${1}${2:+.$2}.pid" 2>/dev/null)
    [ -z "$pid" ] && return 1
    kill -0 "$pid" 2>/dev/null
}

_each_instance() {
    local callback="$1" enabled_only="$2"
    local tmp sid name enabled type tun_name
    tmp=$(make_tmp)

    uci -q show vnt2 2>/dev/null \
        | grep -E "^vnt2\.[^.]*=(vnt|vnts)$" > "$tmp"

    while IFS='=' read -r key type; do
        sid=$(printf '%s' "$key" | cut -d. -f2)
        case "$sid" in web_*) continue ;; esac
        name=$(uci -q get "vnt2.${sid}.name")
        [ -z "$name" ] && continue
        [ -f "${CONFIG_PATH}/${name}.${type}" ] || continue
        if [ "$enabled_only" = "1" ]; then
            enabled=$(uci -q get "vnt2.${sid}.enabled")
            [ "$enabled" != "1" ] && continue
        fi
        tun_name=$(get_tun_name "$name" "$type")
        "$callback" "$name" "$type" "$tun_name"
    done < "$tmp"

    rm -f "$tmp"
}

each_enabled_instance() { _each_instance "$1" "1"; }
each_all_instance()     { _each_instance "$1";     }

each_enabled_vnts() {
    local callback="$1" tmp sid name enabled tun_name
    tmp=$(make_tmp)
    uci -q show vnt2 2>/dev/null | grep -E "^vnt2\.[^.]*=vnts$" > "$tmp"
    while IFS='=' read -r key _; do
        sid=$(printf '%s' "$key" | cut -d. -f2)
        name=$(uci -q get "vnt2.${sid}.name")
        enabled=$(uci -q get "vnt2.${sid}.enabled")
        [ -z "$name" ] || [ "$enabled" != "1" ] && continue
        tun_name=$(get_tun_name "$name" "vnts")
        "$callback" "$name" "vnts" "$tun_name"
    done < "$tmp"
    rm -f "$tmp"
}


setup_cron() {
    local enabled interval new_entry existing
    enabled=$(uci -q get vnt2.global.auto_update)
    interval=$(uci -q get vnt2.global.update_interval)
    interval="${interval:-7}"
    new_entry="0 3 */${interval} * * $UPDATE_SCRIPT #${CRON_TAG}"
    existing=$(grep "${CRON_TAG}" "$CRON_FILE" 2>/dev/null)
    [ "$enabled" = "1" ] && [ "$existing" = "$new_entry" ] && return
    [ "$enabled" != "1" ] && [ -z "$existing" ] && return
    sed -i "/${CRON_TAG}/d" "$CRON_FILE"
    [ "$enabled" = "1" ] && echo "$new_entry" >> "$CRON_FILE"
    "$INITD/cron" restart
}

uci_fw_rule() {
    local sid="$1" stype key val; shift
    stype=$(printf '%s' "$1" | cut -d= -f2); shift
    uci -q delete "firewall.${sid}"
    uci set "firewall.${sid}=${stype}"
    for kv in "$@"; do
        key=$(printf '%s' "$kv" | cut -d= -f1)
        val=$(printf '%s' "$kv" | cut -d= -f2-)
        uci set "firewall.${sid}.${key}=${val}"
    done
}

scan_tuntap_devices() {
    local d dev
    for d in /sys/class/net/*; do
        [ -e "$d/tun_flags" ] || continue
        dev=${d##*/}
        [ -n "$dev" ] && printf '%s\n' "$dev"
    done | sort -u
}

_schedule_fw_reload() {
    mkdir -p "$RUN_DIR"
    if mkdir "$TUNTAP_RELOAD_LOCK" 2>/dev/null; then
        setsid sh -c "sleep 1; fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1; rmdir '$TUNTAP_RELOAD_LOCK' 2>/dev/null" >/dev/null 2>&1 &
    fi
}

cleanup_tuntap_include() {
    rm -f "$TUNTAP_NFT"
    if uci -q get "firewall.${TUNTAP_INCLUDE}" >/dev/null 2>&1; then
        uci -q delete "firewall.${TUNTAP_INCLUDE}"
        return 0
    fi
    return 1
}

sync_zone_devices() {
    local desired current d
    desired="$(scan_tuntap_devices)"
    current="$(uci -q get "firewall.${FW_ZONE}.device" 2>/dev/null | tr ' ' '\n' | grep -v '^$' | sort -u)"
    [ "$desired" = "$current" ] && return 1
    uci -q delete "firewall.${FW_ZONE}.device"
    for d in $desired; do
        uci add_list "firewall.${FW_ZONE}.device=$d"
    done
    return 0
}

refresh_tuntap_firewall() {
    init_paths
    local changed=1
    cleanup_tuntap_include && changed=0
    sync_zone_devices && changed=0
    [ "$changed" = "0" ] || return 0
    uci commit firewall
    _schedule_fw_reload
}

_create_iface() {
    local name="$1" type="$2" tun_name="$3"
    [ -z "$tun_name" ] && return
    local sid
    sid=$(iface_sid "$name")
    uci -q delete "network.${sid}"
    uci set "network.${sid}=interface"
    uci set "network.${sid}.device=${tun_name}"
    uci set "network.${sid}.proto=none"
}

_delete_iface() {
    local name="$1"
    uci -q delete "network.$(iface_sid "$name")"
}

_remove_all_vnt2_ifaces() {
    local tmp sid
    tmp=$(make_tmp)
    uci -q show network | grep -oE "network\.[a-zA-Z0-9_]+=interface" \
        | cut -d. -f2 | cut -d= -f1 > "$tmp"
    while read -r sid; do
        printf '%s' "$sid" | grep -q "^${IFACE_PREFIX}_" \
            && uci -q delete "network.${sid}"
    done < "$tmp"
    rm -f "$tmp"
}


rebuild_network_interfaces() {
    _remove_all_vnt2_ifaces
    each_enabled_vnts _create_iface
    uci commit network
    "$INITD/network" reload 2>/dev/null
}

cleanup_network_interfaces() {
    _remove_all_vnt2_ifaces
    uci commit network
    "$INITD/network" reload 2>/dev/null
}

cleanup_fw() {
    local tmp key sid
    tmp=$(make_tmp)
    uci -q delete "firewall.${FW_ZONE}"
    uci -q delete "firewall.vnt2_ports"
    uci -q delete "firewall.vnt2_web_rule"
    uci -q delete "firewall.vnt2_web_redirect"
    uci -q show firewall 2>/dev/null | sed -n 's/^firewall\.\(vnt2_vnts_wg_[^.]*\)=.*/\1/p' | while read -r sid; do
        [ -n "$sid" ] && uci -q delete "firewall.${sid}"
    done
    printf '%s\n' "$FW_FORWARD_DEFS" | grep -v '^$' > "$tmp"
    while IFS='|' read -r key _ _; do
        uci -q delete "firewall.vnt2_fwd_${key}"
    done < "$tmp"
    rm -f "$tmp"
}

apply_fw_forwardings() {
    local tmp key src dest sid
    tmp=$(make_tmp)
    printf '%s\n' "$FW_FORWARD_DEFS" | grep -v '^$' > "$tmp"
    while IFS='|' read -r key src dest; do
        sid="vnt2_fwd_${key}"
        uci -q delete "firewall.${sid}"
        [ "$(uci -q get "vnt2.global.${key}")" != "1" ] && continue
        uci_fw_rule "$sid" \
            "type=forwarding" \
            "src=${src}" \
            "dest=${dest}"
    done < "$tmp"
    rm -f "$tmp"
}

_collect_instance_ports() {
    local name="$1" type="$2"
    local conf="${CONFIG_PATH}/${name}.${type}"
    local field val port fields

    case "$type" in
        vnt)  fields="$VNT_PORT_FIELDS"  ;;
        vnts) fields="$VNTS_PORT_FIELDS" ;;
    esac

    for field in $fields; do
        val=$(read_field "$conf" "$field")
        [ -z "$val" ] && continue
        port=$(extract_port "$val")
        [ -n "$port" ] && echo "$port" >> "$_PORTS_TMP"
    done

    case "$type" in vnt)
        extract_port_mappings "$conf" | sed 's/.*://' >> "$_PORTS_TMP"
        ;;
        vnts)
        local ike_enabled ike_val
        ike_enabled=$(read_field "$conf" "enabled")
        if [ "$ike_enabled" = "true" ]; then
            for ike_field in ike_bind natt_bind; do
                ike_val=$(read_field "$conf" "$ike_field")
                port=$(extract_port "$ike_val")
                [ -n "$port" ] && echo "$port" >> "$_PORTS_TMP"
            done
        fi
        ;;
    esac
}

apply_fw_ports() {
    local sid="vnt2_ports" all_ports port
    uci -q delete "firewall.${sid}"

    _PORTS_TMP=$(make_tmp)
    each_enabled_instance _collect_instance_ports
    all_ports=$(sort -un "$_PORTS_TMP" | tr '\n' ' ')
    all_ports="${all_ports% }"
    rm -f "$_PORTS_TMP"

    [ -z "$all_ports" ] && return

    uci_fw_rule "$sid" \
        "type=rule" \
        "name=vnt2_allow_ports" \
        "src=wan" \
        "proto=tcp udp" \
        "target=ACCEPT"

    for port in $all_ports; do
        uci add_list "firewall.${sid}.dest_port=${port}"
    done
}

_collect_web_ports() {
    local name="$1" type="$2"
    local conf="${CONFIG_PATH}/${name}.${type}"
    local val port field

    case "$type" in
        vnt)
            return
            ;;
        vnts)
            if [ "$(uci -q get vnt2.global.fw_vnts_web)" = "1" ]; then
                val=$(read_field "$conf" "web_bind")
                [ -n "$val" ] && {
                    port=$(extract_port "$val")
                    [ -n "$port" ] && echo "$port" >> "$_WEB_PORTS_TMP"
                }
            fi
            for field in $VNTS_PORT_FIELDS; do
                val=$(read_field "$conf" "$field")
                [ -z "$val" ] && continue
                port=$(extract_port "$val")
                [ -n "$port" ] && echo "$port" >> "$_WEB_PORTS_TMP"
            done
            ;;
    esac
}

_collect_sorted_ports() {
    local collector="$1" tmp all_ports
    tmp=$(make_tmp)
    eval "${collector%%_collect*}_PORTS_TMP"='"$tmp"'
    each_enabled_instance "$collector"
    all_ports=$(sort -un "$tmp" | tr '\n' ' ')
    rm -f "$tmp"
    printf '%s' "${all_ports% }"
}

_collect_vnts_wireguard() {
    local name="$1" type="$2"
    local conf="${CONFIG_PATH}/${name}.${type}"
    local enabled bind endpoint port
    [ "$type" = "vnts" ] || return
    enabled=$(read_section_field "$conf" wireguard enabled)
    [ "$enabled" = "true" ] || [ "$enabled" = "1" ] || return
    bind=$(read_section_field "$conf" wireguard bind)
    endpoint=$(read_section_field "$conf" wireguard endpoint)
    port=$(extract_port "$bind")
    [ -n "$port" ] && echo "$port" >> "$_WG_BIND_TMP"
    [ -n "$endpoint" ] && echo "$endpoint" >> "$_WG_ENDPOINT_TMP"
}

apply_fw_vnts_wireguard() {
    local ports endpoints port sid
    _WG_BIND_TMP=$(make_tmp)
    _WG_ENDPOINT_TMP=$(make_tmp)
    each_enabled_instance _collect_vnts_wireguard
    ports=$(sort -un "$_WG_BIND_TMP" | tr '\n' ' ')
    ports="${ports% }"
    endpoints=$(sort -u "$_WG_ENDPOINT_TMP" | tr '\n' ' ')
    endpoints="${endpoints% }"
    rm -f "$_WG_BIND_TMP" "$_WG_ENDPOINT_TMP"

    for port in $ports; do
        sid="vnt2_vnts_wg_dnat_${port}"
        uci_fw_rule "$sid" \
            "type=redirect" \
            "name=vnt2_vnts_wireguard_${port}" \
            "src=wan" \
            "proto=udp" \
            "src_dport=${port}" \
            "target=DNAT"
    done

    [ -z "$endpoints" ] && return
    uci_fw_rule "vnt2_vnts_wg_endpoint_out" \
        "type=forwarding" \
        "src=${FW_ZONE}" \
        "dest=wan"
}
apply_fw_web_redirect() {
    local sid="vnt2_web_rule"
    local all_ports port

    uci -q delete "firewall.${sid}"

    _WEB_PORTS_TMP=$(make_tmp)
    each_enabled_instance _collect_web_ports
    all_ports=$(sort -un "$_WEB_PORTS_TMP" | tr '\n' ' ')
    all_ports="${all_ports% }"
    rm -f "$_WEB_PORTS_TMP"
    [ -z "$all_ports" ] && return

    uci_fw_rule "$sid" \
        "type=rule" \
        "name=vnt2_allow_web" \
        "src=wan" \
        "proto=tcp" \
        "target=ACCEPT"

    for port in $all_ports; do
        uci add_list "firewall.${sid}.dest_port=${port}"
    done
}

rebuild_fw_zone() {
    uci_fw_rule "$FW_ZONE" \
        "type=zone" \
        "name=${FW_ZONE}" \
        "input=ACCEPT" \
        "output=ACCEPT" \
        "forward=ACCEPT" \
        "masq=1"
}

_fw_reload() {
    fw4 reload 2>/dev/null || "$INITD/firewall" reload
}

rebuild_firewall() {
    rebuild_fw_zone
    apply_fw_forwardings
    apply_fw_ports
    apply_fw_web_redirect
    apply_fw_vnts_wireguard
    cleanup_tuntap_include
    sync_zone_devices
    uci commit firewall
    _fw_reload
}

get_bin_args() {
    local name="$1" type="$2" conf="$3"
    local tmp key sid method bin tpl cmd
    tmp=$(make_tmp)

    uci -q show vnt2 2>/dev/null \
        | grep "^vnt2\.[^.]*=${type}$" > "$tmp"

    while IFS='=' read -r key _; do
        sid=$(printf '%s' "$key" | cut -d. -f2)
        if [ "$(uci -q get "vnt2.${sid}.name")" = "$name" ]; then
            break
        fi
        sid=""
    done < "$tmp"
    rm -f "$tmp"

    method=$(uci -q get "vnt2.${sid}.start_method")
    method="${method:-vnt2_cli}"

    case "$type" in
        vnt)
            bin=$(adv_bin vnt_cli vnt2_cli)
            tpl=$(adv_cmd start_vnt_cli '{bin} --conf {conf}')
            ;;
        vnts)
            bin=$(adv_bin vnts vnts2)
            tpl=$(adv_cmd start_vnts '{bin} -c {conf}')
            ;;
        *)
            return 1
            ;;
    esac
    cmd=$(render_template "$tpl" "$bin" "$conf" "$name" "$type")
    cmdline_to_pipes "$cmd"
}
_cleanup_tun() {
    local name="$1" type="$2" tun_name="$3"
    [ -n "$tun_name" ] && ip link delete "$tun_name" 2>/dev/null
    _delete_iface "$name"
}


_do_start_vnt_web() {
    local log_file bin_args bin tpl cmd
    log_file="${LOG_DIR}/${WEB_INSTANCE}.log"
    touch "$log_file" 2>/dev/null
    bin="$(adv_bin vnt_web vnt2_web)"
    [ -x "$bin" ] || {
        _instance_log "$WEB_INSTANCE" "Start failed: binary is not executable: $bin"
        return 1
    }
    tpl=$(adv_cmd start_vnt_web '{bin} --addr {web_addr} --token {token}')
    [ -z "$WEB_TOKEN" ] && tpl=$(printf '%s' "$tpl" | sed 's/[[:space:]]*--token[[:space:]]*{token}//g')
    cmd=$(render_template "$tpl" "$bin" "" "$WEB_INSTANCE" "web")
    bin_args=$(cmdline_to_pipes "$cmd")
    procd_open_instance "$WEB_INSTANCE"
    procd_set_param command "$VNT_RUN" "$WEB_INSTANCE" "$log_file" "web"
    local IFS='|'
    procd_append_param command $bin_args
    unset IFS
    procd_set_param env VNT_WEB_TOKEN="$WEB_TOKEN"
    procd_set_param env VNT_WEB_DATA_DIR="$WEB_DATA_DIR"
    procd_set_param respawn "$RESPAWN_THRESHOLD" "$RESPAWN_TIMEOUT" "$RESPAWN_RETRY"
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param pidfile "/var/run/vnt2_${WEB_INSTANCE}.pid"
    procd_close_instance
    _instance_log "$WEB_INSTANCE" "Registered vnt2_web addr=${WEB_ADDR}"
    setsid /usr/libexec/vnt2-web-sync.sh >/dev/null 2>&1 &
}

_do_start_instance() {
    local name="$1" type="$2" tun_name="$3"
    local conf="${CONFIG_PATH}/${name}.${type}"
    local bin_args bin log_file
    log_file="${LOG_DIR}/${name}.${type}.log"

    [ ! -f "$conf" ] && {
        _instance_log "${name}.${type}" "Start failed: config file does not exist: $conf"
        return 1
    }
    bin_args=$(get_bin_args "$name" "$type" "$conf")
    [ -z "$bin_args" ] && {
        _instance_log "${name}.${type}" "Start failed: unable to build startup command"
        return 1
    }
    bin=$(printf '%s' "$bin_args" | cut -d'|' -f1)
    [ ! -x "$bin" ] && {
        _instance_log "${name}.${type}" "Start failed: binary is not executable: $bin"
        return 1
    }
    if ! is_instance_running "$name" "$type"; then
        [ -n "$tun_name" ] && ip link delete "$tun_name" 2>/dev/null
    fi

    procd_open_instance "${name}.${type}"
    procd_set_param command "$VNT_RUN" "$name" "$log_file" "$type"
    local IFS='|'
    procd_append_param command $bin_args
    unset IFS
    procd_set_param env STARTUP_CHECK_WINDOW="$STARTUP_CHECK_WINDOW" KILL_INTERVAL="$KILL_INTERVAL"
    procd_set_param respawn "$RESPAWN_THRESHOLD" "$RESPAWN_TIMEOUT" "$RESPAWN_RETRY"
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param pidfile "/var/run/vnt2_${name}.${type}.pid"
    procd_close_instance

    _instance_log "${name}.${type}" "Registered type=$type bin=$bin tun=${tun_name:-auto}"
}

service_triggers() {
    procd_add_reload_trigger "vnt2"
}

start_service() {
    init_paths
    local missing=""
    [ -x "${BIN_PATH}/vnt2_cli" ] || missing="vnt"
    [ -x "${BIN_PATH}/vnts2" ]    || missing="${missing:+$missing }vnts"
    if [ -n "$missing" ]; then
        [ -x "$UPDATE_SCRIPT" ] && {
            echo "Starting automatic download of $missing ..."
            setsid sh -c "$UPDATE_SCRIPT $missing" >/dev/null 2>&1 &
        }
        return 0
    fi
    echo "VNT2: starting all enabled instances..."
    if [ "$WEB_ENABLED" = "1" ]; then
        _do_start_vnt_web
    fi
    each_enabled_instance _do_start_instance
    rebuild_network_interfaces
    rebuild_firewall
    ( sleep 8; "$INITD/vnt2" refresh_tuntap_firewall ) >/dev/null 2>&1 </dev/null &
}

stop_service() {
    each_enabled_instance _cleanup_tun
    cleanup_network_interfaces
    cleanup_tuntap_include
    sync_zone_devices
    uci commit firewall
    _fw_reload
}

reload_service() {
    init_paths
    setup_cron
    rebuild_network_interfaces
    rebuild_firewall
}