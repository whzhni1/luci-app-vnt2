# [string]
# zh-cn: 可选的服务端配置源，填入 vnt2:// 订阅链接；本文件中明确填写的字段会覆盖订阅下发的同名字段
# en: Optional server configuration source, a vnt2:// subscription link; fields explicitly set in this file override the same fields delivered by the subscription
# 示例: vnt2://join/2/xxxx
subscription = ""

# [string] 必填
# zh-cn: 网络编号，相同编号的设备组成同一虚拟局域网
# en: Network code, devices with the same code form a virtual LAN
# 示例: office
network_code = ""

# [array] 必填
# zh-cn: 服务器地址列表，支持 quic/tcp/wss/dynamic 协议，省略协议默认 tcp；dynamic 默认使用 DNS TXT 解析记录，也支持填入 http(s) 接口地址返回换行分隔的服务器列表
# en: Server address list, supports quic/tcp/wss/dynamic protocols; defaults to tcp without a scheme; dynamic resolves DNS TXT records by default and also accepts an http(s) endpoint returning a newline-separated server list
# 示例: quic://vpn.example.com:29872
server = []

# [array]
# zh-cn: 可直连节点地址列表，支持 ip:端口、tcp://、udp:// 和 dynamic://（DNS TXT 或 http(s) 接口返回换行分隔的直连地址列表），端口为对端 tunnel_addr 中配置的监听端口
# en: Direct peer addresses, supports ip:port, tcp://, udp:// and dynamic:// (DNS TXT or an http(s) endpoint returning a newline-separated list); the port is the listen port in the peer tunnel_addr
# 示例: 192.168.1.10:29873
peer_address = []

# [array]
# zh-cn: 指定目标 IP 或网段的优先中转虚拟 IP，格式：目标,中转虚拟 IP；填写网关 IP 时强制走服务器中继，命中目标不参与 P2P 打洞
# en: Preferred TURN virtual IP for a target IP or subnet, format: target,turn virtual IP; use the gateway IP to force server relay, matched targets skip P2P hole punching
# 示例: 10.26.0.0/24,10.26.0.2
turn = []

# [array]
# zh-cn: 指定目标 IP 或网段允许的打洞方式，格式：目标,模式(可多个)；模式可选 IPv4Tcp/IPv4Udp/IPv6Tcp/IPv6Udp，不区分大小写
# en: Allowed hole-punching modes for a target IP or subnet, format: target,mode[,mode...]; modes: IPv4Tcp/IPv4Udp/IPv6Tcp/IPv6Udp (case-insensitive)
# 示例: 10.26.1.0/24,IPv4Tcp,IPv4Udp
punch_model = []

# [string]
# zh-cn: 固定虚拟 IP/CIDR（纯 IP 默认 /24），留空自动分配；无服务器或多服务器时必填，填写后本地网络立即启动、服务器在后台连接
# en: Fixed virtual IP/CIDR (plain IP defaults to /24), leave empty for auto assignment; required when server is empty or has multiple entries, the local network starts immediately while servers connect in the background
# 示例: 10.26.0.10/24
ip = ""

# [bool]
# zh-cn: 启用 QUIC 优化传输
# en: Enable QUIC optimized transport
rtx = false

# [bool]
# zh-cn: 启用 FEC 前向纠错
# en: Enable FEC forward error correction
fec = false

# [bool]
# zh-cn: 关闭 P2P 打洞，流量主要经服务器中继（显式 peer_address 仍可直连）
# en: Disable P2P hole punching; traffic mainly relays via the server (explicit peer_address still connects directly)
no_punch = false

# [bool]
# zh-cn: 关闭 IPv4 广播和组播转发
# en: Disable IPv4 broadcast and multicast forwarding
no_broadcast = false

# [bool]
# zh-cn: 允许与 IKEv2/IPsec 客户端互通，信任服务端注入的 IKEv2 明文包，请仅连接受信任的服务端
# en: Allow communication with IKEv2/IPsec clients; trusts server-injected IKEv2 plaintext packets, only use with trusted servers
allow_ikev2 = false

# [bool]
# zh-cn: 允许与 WireGuard 客户端互通，信任服务端注入的 WireGuard 明文 IPv4 包，请仅连接受信任的服务端
# en: Allow communication with WireGuard clients; trusts server-injected WireGuard plaintext IPv4 packets, only use with trusted servers
allow_wireguard = false

# [bool]
# zh-cn: 启用 LZ4 数据压缩
# en: Enable LZ4 data compression
compress = false

# [array]
# zh-cn: 入栈监听网段（点对网，配置在访问端），格式：CIDR,出口节点虚拟IP
# en: Inbound listening subnet (site-to-site, set on the access side), format: CIDR,exit node virtual IP
# 示例: 192.168.1.0/24,10.26.0.10
input = []

# [array]
# zh-cn: 出栈子网映射（配置在出口端），解决访问端与目标端局域网网段冲突，格式：映射CIDR,真实CIDR，两侧掩码必须相同；多条规则按最长前缀匹配，真实 CIDR 必须由本机 output 完整覆盖
# en: Outbound subnet mapping (set on the exit side), resolves LAN subnet conflicts; format: mapped CIDR,actual CIDR with equal prefix lengths; longest prefix match wins and the actual CIDR must be fully covered by the local output list
# 示例: 192.168.2.0/24,192.168.1.0/24
subnet_mapping = []

# [array]
# zh-cn: 出栈允许网段（点对网授权边界，配置在出口端），格式：CIDR
# en: Outbound allowed subnet (site-to-site authorization boundary, set on the exit side), format: CIDR
# 示例: 192.168.1.0/24
output = []

# [bool]
# zh-cn: 自动获取并应用其他在线节点上报的出口子网路由，本机手动 input 规则优先
# en: Automatically sync and apply exit subnets reported by other online peers; local input rules take priority
auto_sync_subnet = false

# [bool]
# zh-cn: 关闭内置子网 NAT，改用操作系统转发
# en: Disable built-in subnet NAT and use OS forwarding instead
no_nat = false

# [select]
# zh-cn: 虚拟网卡模式：no 不创建网卡、tun 三层网卡、tap 二层网卡
# en: Virtual network interface mode: no (no interface), tun (layer 3), tap (layer 2)
# 选项: no, tun, tap
device_mode = "tun"

# [array]
# zh-cn: 端口映射规则，格式：协议://本地监听地址-出口虚拟IP-最终目标地址；出口节点需开启 allow_mapping
# en: Port mapping rules, format: protocol://local listen address-exit virtual IP-final target address; the exit node must enable allow_mapping
# 示例: tcp://0.0.0.0:8080-10.26.0.10-192.168.1.10:80
port_mapping = []

# [bool]
# zh-cn: 允许本设备作为端口映射出口，仅应在受信任的虚拟网络中开启
# en: Allow this device as a port mapping exit; only enable in trusted virtual networks
allow_mapping = false

# [int]
# zh-cn: 控制服务 TCP 端口，设置 0 禁用
# en: Control service TCP port, set 0 to disable
# 示例: 11233
ctrl_port = 11233

# [array]
# zh-cn: P2P 隧道监听地址，IPv4 与 IPv6 最多各一个且必须使用相同端口；未配置的地址族仍使用通配地址，端口 0 表示自动分配；旧版 tunnel_port 仍兼容，但不能与 tunnel_addr 同时使用
# en: P2P tunnel listen addresses, at most one IPv4 and one IPv6 and both must use the same port; unconfigured families still bind the wildcard address, port 0 means automatic allocation; the legacy tunnel_port remains compatible but cannot be combined with tunnel_addr
# 示例: 192.168.1.10:29873
tunnel_addr = []

# [int]
# zh-cn: MTU 值，默认 1400，常用范围 1200-1500
# en: MTU value, default 1400, typical range 1200-1500
# 示例: 1400
mtu = 1400

# [string]
# zh-cn: 设备名称，留空自动读取主机名
# en: Device name, leave empty to use hostname
# 示例: office-pc
device_name = ""

# [string]
# zh-cn: 设备唯一 ID，留空自动生成
# en: Device ID, leave empty to generate automatically
# 示例: device-001
device_id = ""

# [string]
# zh-cn: 虚拟网卡名称
# en: Virtual network interface name
# 示例: vnt-tun0
tun_name = ""

# [string]
# zh-cn: 对外通信 Socket 使用的出口网卡名称
# en: Outbound interface used for communication sockets
# 示例: eth0
outbound_interface = ""

# [string]
# zh-cn: 事件脚本路径或命令，在网卡创建、掉线、重连或 IP 变化时调用
# en: Event script or command invoked on interface and IP events
# 示例: /etc/vnt2/event.sh
event_script = ""

# [string]
# zh-cn: 组网加密密码，所有互通节点必须一致，留空不启用
# en: Network encryption password; all peers must use the same password, empty disables it
# 示例: your-secret-password
password = ""

# [select]
# zh-cn: 证书校验方式：skip 跳过、standard 系统证书、finger 证书指纹（选择 finger 时需将下方值改为 finger:SHA256指纹）
# en: Certificate verification mode: skip, standard (system CA), finger (certificate fingerprint; when using finger set the value to finger:SHA256-hex)
# 选项: skip, standard, finger
# extend: finger=text(prefix=finger:, placeholder=finger:SHA256)
cert_mode = "skip"

# [array]
# zh-cn: 自定义 UDP STUN 服务器地址
# en: Custom UDP STUN server addresses
# 示例: stun.example.com:3478
udp_stun = []

# [array]
# zh-cn: 自定义 TCP STUN 服务器地址
# en: Custom TCP STUN server addresses
# 示例: stun.example.com:3478
tcp_stun = []



